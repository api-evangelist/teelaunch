            "params": [
              {
                "name": "platformStoreId",
                "value": "",
                "type": "path",
                "description": "Platform Store Id"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Platform Store Product Id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Platform Product By Id\n\nGet platform product by id"
