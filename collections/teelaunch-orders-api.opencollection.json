            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Release Order\n\nRelease account order. Note that only hold and out of stock orders can be released"
        },
        {
          "info": {
            "name": "Hold Order",
            "type": "http"
