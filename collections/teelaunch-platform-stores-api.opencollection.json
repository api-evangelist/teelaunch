{
  "opencollection": "1.0.0",
  "info": {
    "name": "teelaunch Account Platform Stores API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Platform Stores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.teelaunch.com/api/v1/stores",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (default: 1)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Stores\n\nGet stores"
        },
        {
          "info": {
            "name": "Get Store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.teelaunch.com/api/v1/stores/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Platform Store Id"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Store\n\nGet store by Id"
        }
      ]
    }
  ],
  "bundled": true
}